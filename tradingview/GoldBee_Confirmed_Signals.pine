//@version=6
strategy(
     "Gold Bee — Confirmed XAUUSD Signal Lab",
     overlay = true,
     initial_capital = 1000,
     pyramiding = 0,
     process_orders_on_close = true,
     commission_type = strategy.commission.percent,
     commission_value = 0.01,
     slippage = 2
)

// Gold Bee research baseline. Signals are confirmed only at candle close.
// This script cannot guarantee future direction or reproduce a broker's exact spread/fills.
// Test on the exact broker symbol and timeframe before relying on any result.

fastLen = input.int(9, "Fast EMA", minval = 2)
slowLen = input.int(21, "Slow EMA", minval = 3)
trendLen = input.int(50, "Trend EMA", minval = 10)
majorTrendLen = input.int(200, "Major trend EMA", minval = 50)
rsiLen = input.int(14, "RSI length", minval = 2)
adxLen = input.int(14, "DI length", minval = 2)
adxSmooth = input.int(14, "ADX smoothing", minval = 2)
minimumAdx = input.float(18.0, "Minimum ADX", minval = 5, step = 0.5)
atrLen = input.int(14, "ATR length", minval = 2)
stopAtr = input.float(1.5, "Stop distance × ATR", minval = 0.5, step = 0.1)
rewardRisk = input.float(1.5, "Take-profit R:R", minval = 1.0, step = 0.1)
allowLong = input.bool(true, "Enable BUY signals")
allowShort = input.bool(true, "Enable SELL signals")

emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)
emaMajor = ta.ema(close, majorTrendLen)
rsiValue = ta.rsi(close, rsiLen)
[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxSmooth)
atrValue = ta.atr(atrLen)

enoughData = not na(emaMajor) and not na(adxValue) and not na(atrValue) and atrValue > syminfo.mintick
trendUp = close > emaTrend and emaTrend > emaMajor
trendDown = close < emaTrend and emaTrend < emaMajor
momentumUp = rsiValue >= 52 and plusDI > minusDI
momentumDown = rsiValue <= 48 and minusDI > plusDI
marketMoving = adxValue >= minimumAdx

buySignal = barstate.isconfirmed and enoughData and allowLong and trendUp and momentumUp and marketMoving and ta.crossover(emaFast, emaSlow)
sellSignal = barstate.isconfirmed and enoughData and allowShort and trendDown and momentumDown and marketMoving and ta.crossunder(emaFast, emaSlow)

var float plannedEntry = na
var float plannedSL = na
var float plannedTP = na
var string lastDecision = "WAIT"
var int lastSignalBar = na

if buySignal and strategy.position_size <= 0
    plannedEntry := close
    plannedSL := close - atrValue * stopAtr
    plannedTP := close + atrValue * stopAtr * rewardRisk
    lastDecision := "BUY"
    lastSignalBar := bar_index
    strategy.entry("BUY", strategy.long, alert_message = "GOLD BEE BUY | {{ticker}} | {{interval}} | confirmed candle close")
    strategy.exit("BUY exit", from_entry = "BUY", stop = plannedSL, limit = plannedTP, alert_message = "GOLD BEE BUY EXIT | {{ticker}} | {{interval}}")

if sellSignal and strategy.position_size >= 0
    plannedEntry := close
    plannedSL := close + atrValue * stopAtr
    plannedTP := close - atrValue * stopAtr * rewardRisk
    lastDecision := "SELL"
    lastSignalBar := bar_index
    strategy.entry("SELL", strategy.short, alert_message = "GOLD BEE SELL | {{ticker}} | {{interval}} | confirmed candle close")
    strategy.exit("SELL exit", from_entry = "SELL", stop = plannedSL, limit = plannedTP, alert_message = "GOLD BEE SELL EXIT | {{ticker}} | {{interval}}")

// Keep exits updated only from the levels calculated at entry.
if strategy.position_size > 0
    strategy.exit("BUY exit", from_entry = "BUY", stop = plannedSL, limit = plannedTP, alert_message = "GOLD BEE BUY EXIT | {{ticker}} | {{interval}}")
if strategy.position_size < 0
    strategy.exit("SELL exit", from_entry = "SELL", stop = plannedSL, limit = plannedTP, alert_message = "GOLD BEE SELL EXIT | {{ticker}} | {{interval}}")

plot(emaFast, "EMA Fast", color = color.aqua)
plot(emaSlow, "EMA Slow", color = color.orange)
plot(emaTrend, "EMA Trend", color = color.blue, linewidth = 2)
plot(emaMajor, "EMA Major Trend", color = color.purple, linewidth = 2)
plot(strategy.position_size != 0 ? plannedEntry : na, "Planned Entry", color = color.white, linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? plannedSL : na, "Stop Loss", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? plannedTP : na, "Take Profit", color = color.lime, linewidth = 2, style = plot.style_linebr)

plotshape(buySignal, title = "Confirmed BUY", text = "BUY", style = shape.labelup, location = location.belowbar, color = color.lime, textcolor = color.black, size = size.small)
plotshape(sellSignal, title = "Confirmed SELL", text = "SELL", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.small)

var table panel = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    string decision = strategy.position_size > 0 ? "BUY ACTIVE" : strategy.position_size < 0 ? "SELL ACTIVE" : "WAIT / NO TRADE"
    color decisionColor = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(panel, 0, 0, "GOLD BEE", text_color = color.white, bgcolor = color.rgb(35, 43, 55))
    table.cell(panel, 1, 0, decision, text_color = color.white, bgcolor = decisionColor)
    table.cell(panel, 0, 1, "Trend")
    table.cell(panel, 1, 1, trendUp ? "UP" : trendDown ? "DOWN" : "MIXED")
    table.cell(panel, 0, 2, "RSI")
    table.cell(panel, 1, 2, str.tostring(rsiValue, "#.0"))
    table.cell(panel, 0, 3, "ADX")
    table.cell(panel, 1, 3, str.tostring(adxValue, "#.0"))
    table.cell(panel, 0, 4, "Entry")
    table.cell(panel, 1, 4, strategy.position_size != 0 ? str.tostring(plannedEntry, format.mintick) : "—")
    table.cell(panel, 0, 5, "Stop Loss")
    table.cell(panel, 1, 5, strategy.position_size != 0 ? str.tostring(plannedSL, format.mintick) : "—")
    table.cell(panel, 0, 6, "Take Profit")
    table.cell(panel, 1, 6, strategy.position_size != 0 ? str.tostring(plannedTP, format.mintick) : "—")

alertcondition(buySignal, title = "Gold Bee confirmed BUY", message = "Gold Bee BUY signal confirmed at candle close: {{ticker}} {{interval}} close={{close}}")
alertcondition(sellSignal, title = "Gold Bee confirmed SELL", message = "Gold Bee SELL signal confirmed at candle close: {{ticker}} {{interval}} close={{close}}")
