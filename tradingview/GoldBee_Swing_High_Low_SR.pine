//@version=6
indicator("Gold Bee — Confirmed Swing High/Low + S/R", overlay = true, max_lines_count = 100)

// These are confirmed pivots, not predictions. A pivot is only known after
// rightBars subsequent candles have formed.
leftBars = input.int(3, "Pivot bars on left", minval = 1, maxval = 20)
rightBars = input.int(3, "Confirmation bars on right", minval = 1, maxval = 20)
atrLength = input.int(14, "ATR length", minval = 1, maxval = 100)
mergeAtrMultiplier = input.float(0.30, "Zone merge tolerance × ATR", minval = 0.05, maxval = 2.0, step = 0.05)
maximumLevels = input.int(8, "Maximum levels per side", minval = 1, maxval = 20)
showPivotMarkers = input.bool(true, "Show confirmed Swing High/Low markers")

atrNow = ta.atr(atrLength)
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow = ta.pivotlow(low, leftBars, rightBars)

var array<float> resistancePrices = array.new<float>()
var array<line> resistanceLines = array.new<line>()
var array<int> resistanceTouches = array.new<int>()
var array<float> supportPrices = array.new<float>()
var array<line> supportLines = array.new<line>()
var array<int> supportTouches = array.new<int>()
var float previousSwingHigh = na
var float previousSwingLow = na
bool higherHighSignal = false
bool lowerHighSignal = false
bool higherLowSignal = false
bool lowerLowSignal = false
bool resistanceBreakSignal = false
bool supportBreakSignal = false

if not na(pivotHigh)
    higherHighSignal := not na(previousSwingHigh) and pivotHigh > previousSwingHigh
    lowerHighSignal := not na(previousSwingHigh) and pivotHigh < previousSwingHigh
    previousSwingHigh := pivotHigh

if not na(pivotLow)
    higherLowSignal := not na(previousSwingLow) and pivotLow > previousSwingLow
    lowerLowSignal := not na(previousSwingLow) and pivotLow < previousSwingLow
    previousSwingLow := pivotLow

addOrMergeLevel(array<float> prices, array<line> lines, array<int> touches, float price, float atrValue, color levelColor) =>
    if not na(price)
        float tolerance = math.max(nz(atrValue, 0.0) * mergeAtrMultiplier, math.abs(price) * 0.00025)
        int matchedIndex = -1
        if array.size(prices) > 0
            for i = 0 to array.size(prices) - 1
                if math.abs(array.get(prices, i) - price) <= tolerance
                    matchedIndex := i
                    break

        if matchedIndex >= 0
            int oldTouches = array.get(touches, matchedIndex)
            float oldPrice = array.get(prices, matchedIndex)
            float mergedPrice = (oldPrice * oldTouches + price) / (oldTouches + 1)
            array.set(prices, matchedIndex, mergedPrice)
            array.set(touches, matchedIndex, oldTouches + 1)
            line existingLine = array.get(lines, matchedIndex)
            line.set_y1(existingLine, mergedPrice)
            line.set_y2(existingLine, mergedPrice)
            line.set_width(existingLine, oldTouches >= 3 ? 3 : 2)
        else
            if array.size(prices) >= maximumLevels
                array.shift(prices)
                line.delete(array.shift(lines))
                array.shift(touches)
            line newLine = line.new(
                 x1 = bar_index - rightBars,
                 y1 = price,
                 x2 = bar_index,
                 y2 = price,
                 extend = extend.right,
                 color = levelColor,
                 width = 1
             )
            array.push(prices, price)
            array.push(lines, newLine)
            array.push(touches, 1)

addOrMergeLevel(resistancePrices, resistanceLines, resistanceTouches, pivotHigh, atrNow, color.red)
addOrMergeLevel(supportPrices, supportLines, supportTouches, pivotLow, atrNow, color.lime)

// Stop extending a level once a candle closes through it. The level is removed
// from the active arrays; the already-drawn line remains on the chart.
if array.size(resistancePrices) > 0
    for i = array.size(resistancePrices) - 1 to 0
        float level = array.get(resistancePrices, i)
        if close > level and close[1] <= level
            line brokenLine = array.get(resistanceLines, i)
            line.set_extend(brokenLine, extend.none)
            line.set_x2(brokenLine, bar_index)
            array.remove(resistancePrices, i)
            array.remove(resistanceLines, i)
            array.remove(resistanceTouches, i)
            resistanceBreakSignal := true

if array.size(supportPrices) > 0
    for i = array.size(supportPrices) - 1 to 0
        float level = array.get(supportPrices, i)
        if close < level and close[1] >= level
            line brokenLine = array.get(supportLines, i)
            line.set_extend(brokenLine, extend.none)
            line.set_x2(brokenLine, bar_index)
            array.remove(supportPrices, i)
            array.remove(supportLines, i)
            array.remove(supportTouches, i)
            supportBreakSignal := true

plotshape(showPivotMarkers and not na(pivotHigh), title = "Confirmed Swing High", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny, offset = -rightBars)
plotshape(showPivotMarkers and not na(pivotLow), title = "Confirmed Swing Low", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny, offset = -rightBars)

plotshape(higherHighSignal, title = "Higher High (HH)", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), text = "HH", textcolor = color.white, size = size.tiny, offset = -rightBars)
plotshape(lowerHighSignal, title = "Lower High (LH)", style = shape.labeldown, location = location.abovebar, color = color.new(color.orange, 0), text = "LH", textcolor = color.white, size = size.tiny, offset = -rightBars)
plotshape(higherLowSignal, title = "Higher Low (HL)", style = shape.labelup, location = location.belowbar, color = color.new(color.lime, 0), text = "HL", textcolor = color.black, size = size.tiny, offset = -rightBars)
plotshape(lowerLowSignal, title = "Lower Low (LL)", style = shape.labelup, location = location.belowbar, color = color.new(color.aqua, 0), text = "LL", textcolor = color.black, size = size.tiny, offset = -rightBars)

alertcondition(not na(pivotHigh), title = "Confirmed Swing High", message = "Gold Bee: confirmed Swing High on {{ticker}} {{interval}} at {{high}}")
alertcondition(not na(pivotLow), title = "Confirmed Swing Low", message = "Gold Bee: confirmed Swing Low on {{ticker}} {{interval}} at {{low}}")
alertcondition(higherHighSignal, title = "Higher High (HH)", message = "Gold Bee: Higher High on {{ticker}} {{interval}}")
alertcondition(higherLowSignal, title = "Higher Low (HL)", message = "Gold Bee: Higher Low on {{ticker}} {{interval}}")
alertcondition(lowerHighSignal, title = "Lower High (LH)", message = "Gold Bee: Lower High on {{ticker}} {{interval}}")
alertcondition(lowerLowSignal, title = "Lower Low (LL)", message = "Gold Bee: Lower Low on {{ticker}} {{interval}}")
alertcondition(resistanceBreakSignal, title = "Resistance broken", message = "Gold Bee: candle closed above a tracked resistance level on {{ticker}} {{interval}}")
alertcondition(supportBreakSignal, title = "Support broken", message = "Gold Bee: candle closed below a tracked support level on {{ticker}} {{interval}}")
